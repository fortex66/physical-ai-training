direction: right
classes: {
  box: {
    width: 170
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 170
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
env: "20 환경 기초\nstep · manager"
obs: "21 관측 · 보상\n정보와 점수"
action: "22 액션 공간\n구동 명령"
complete: "23 환경 조립\n랜덤 기준 측정"
train: "24 PPO 학습\n가중치 저장" {class: focus}
evaluate: "25 정책 평가\n두 정책 비교" {class: focus}
env -> obs -> action -> complete -> train -> evaluate
