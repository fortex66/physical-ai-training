direction: right
classes: {
  box: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
rollout: "경험 · 이전 가치\n행동 확률 저장"
gae: "보상 · 이후 가치\nGAE 계산"
adv: "Advantage\n정책 개선 신호"
target: "Return target\n가치 학습 목표"
actor: "PPO 정책 손실\nclip · entropy" {class: focus}
critic: "가치 손실\n목표와 비교"
weights: "역전파 · optimizer\n가중치 수정" {class: focus}
rollout -> gae
gae -> adv -> actor -> weights
gae -> target -> critic -> weights
