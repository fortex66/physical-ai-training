direction: down
classes: {
  box: {
    width: 135
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 135
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
direction: right
func: "함수\nparams"
mod: modifier
noise: noise
clip: clip {class: focus}
scale: scale
concat: 그룹 연결
func -> mod -> noise -> clip -> scale -> concat
