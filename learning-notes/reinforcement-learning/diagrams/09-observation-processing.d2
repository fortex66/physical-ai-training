direction: down
classes: {
  box: {
    width: 150
    height: 90
    style: {font-size: 24; font-color: "#172B45"; fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 10}
  }
  focus: {
    width: 150
    height: 90
    style: {font-size: 24; font-color: "#173C86"; fill: "#EFF5FF"; stroke: "#5D81D9"; stroke-width: 2; border-radius: 10}
  }
}
*.class: box
*.style.font-size: 24
(* -> *)[*].style.stroke: "#64748B"
(* -> *)[*].style.stroke-width: 2
direction: right
func: "함수\nparams"
mod: modifier
noise: noise
clip: clip {class: focus}
scale: scale
concat: 그룹 연결
func -> mod -> noise -> clip -> scale -> concat
