direction: down
classes: {
  box: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
direction: right
state: 상태 · 행동
alive: "생존 / 종료\n+1 / -2"
upright: "직립\ncos × 2" {class: focus}
center: "중앙\n가우시안 × 0.5"
action: "행동 크기\n제곱합 × -0.001"
vel: "막대 각속도\n절댓값 × -0.005"
out: "가중합 × dt\n반환 보상"
state -> alive -> out
state -> upright -> out
state -> center -> out
state -> action -> out
state -> vel -> out
