direction: right
classes: {
  box: {
    width: 170
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 170
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
input: "입력 행동\n예: 0.5"
process: "scale · offset\n단위 변환"
effort: "힘 명령\n50 N" {class: focus}
position: "위치 목표\n1 m" {class: focus}
velocity: "속도 목표\n2.5 m/s" {class: focus}
robot: "actuator\n물리 운동"
input -> process
process -> effort
process -> position
process -> velocity
effort -> robot
position -> robot
velocity -> robot
