direction: down
classes: {
  box: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
obs: 관측
actor: "행동 선택\nActor" {class: focus}
critic: "가치 추정\nCritic"
env: "물리 진행\nIsaac Lab · Sim"
rollout: 경험 수집
ppo: "가중치 학습\nPPO" {class: focus}
repeat: 바뀐 정책으로 반복
save: 체크포인트 저장
obs -> actor
obs -> critic
actor -> env: 행동
actor -> rollout: 행동 정보 {style.stroke-dash: 4}
env -> rollout: 보상 · 결과
critic -> rollout: 예상 가치
rollout -> ppo
ppo -> repeat
ppo -> save
