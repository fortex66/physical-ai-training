direction: down
classes: {
  box: {
    width: 320
    height: 110
    style: {font-size: 28; font-color: "#172B45"; fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 10}
  }
  focus: {
    width: 320
    height: 110
    style: {font-size: 28; font-color: "#173C86"; fill: "#EFF5FF"; stroke: "#5D81D9"; stroke-width: 2; border-radius: 10}
  }
}
*.class: box
*.style.font-size: 28
(* -> *)[*].style.stroke: "#64748B"
(* -> *)[*].style.stroke-width: 2
obs: 관측
actor: "행동 선택\nActor" {class: focus}
critic: "가치 추정\nCritic"
env: "물리 진행\nIsaac Lab · Sim"
rollout: 경험 수집
ppo: "가중치 학습\nPPO" {class: focus}
repeat: 바뀐 정책으로 반복
save: 체크포인트 저장
obs -> actor
obs -> critic
actor -> env: 행동
actor -> rollout: 행동 정보 {style.stroke-dash: 4}
env -> rollout: 보상 · 결과
critic -> rollout: 예상 가치
rollout -> ppo
ppo -> repeat
ppo -> save
