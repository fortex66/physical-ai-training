direction: down
classes: {
  box: {
    width: 165
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 165
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
direction: right
raw: 함수 값
weight: "가중치 적용\n항별 로그" {class: focus}
time: 환경 dt 적용
rew: step 보상
sum: "에피소드\n누적"
raw -> weight -> time -> rew -> sum
