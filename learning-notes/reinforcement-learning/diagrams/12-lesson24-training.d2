direction: down
classes: {
  box: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#172B45"; fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 10}
  }
  focus: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#173C86"; fill: "#EFF5FF"; stroke: "#5D81D9"; stroke-width: 2; border-radius: 10}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#64748B"
(* -> *)[*].style.stroke-width: 2
cfg: "환경 · 학습 설정\n7차원 관측 · PPO"
connect: "Wrapper · Runner\n모델 생성"
collect: "현재 Actor로 수집\n1024 × 16 전이" {class: focus}
adv: "GAE · return\n학습 목표 계산"
update: "PPO 업데이트\n5 epoch × 4 batch" {class: focus}
log: "지표 · 모델 저장\n다음 iteration"
end: "150 iteration\n최종 체크포인트"
cfg -> connect -> collect -> adv -> update -> log -> end
log -> collect: 바뀐 정책 {style.stroke-dash: 4}
