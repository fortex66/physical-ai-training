direction: down
classes: {
  box: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
obs: "관측 설정\n기본 4 + 추가 3"
reward: "보상 설정\n6개 항"
init: 환경 생성 · 리셋
random: "랜덤 행동\n관측과 무관" {class: focus}
step: "env.step\n물리 · 보상 · 리셋"
log: "관측 7개 · 총 보상\n항별 값 기록"
stop: "1000 환경 step\n실행 종료"
obs -> init
reward -> init
init -> random -> step -> log -> stop
log -> random: 다음 step {style.stroke-dash: 4}
