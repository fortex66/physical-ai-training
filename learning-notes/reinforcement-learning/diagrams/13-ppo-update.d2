direction: right
classes: {
  box: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#172B45"; fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 10}
  }
  focus: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#173C86"; fill: "#EFF5FF"; stroke: "#5D81D9"; stroke-width: 2; border-radius: 10}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#64748B"
(* -> *)[*].style.stroke-width: 2
rollout: "경험 · 이전 가치\n행동 확률 저장"
gae: "보상 · 이후 가치\nGAE 계산"
adv: "Advantage\n정책 개선 신호"
target: "Return target\n가치 학습 목표"
actor: "PPO 정책 손실\nclip · entropy" {class: focus}
critic: "가치 손실\n목표와 비교"
weights: "역전파 · optimizer\n가중치 수정" {class: focus}
rollout -> gae
gae -> adv -> actor -> weights
gae -> target -> critic -> weights
