direction: down
classes: {
  box: {
    width: 280
    height: 90
    style: {font-size: 24; font-color: "#172B45"; fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 10}
  }
  focus: {
    width: 280
    height: 90
    style: {font-size: 24; font-color: "#173C86"; fill: "#EFF5FF"; stroke: "#5D81D9"; stroke-width: 2; border-radius: 10}
  }
}
*.class: box
*.style.font-size: 24
(* -> *)[*].style.stroke: "#64748B"
(* -> *)[*].style.stroke-width: 2
action: "행동 처리\nscale 100"
p1: "물리 step 1\n1/120초" {class: focus}
p2: "물리 step 2\n같은 행동 · 1/120초" {class: focus}
term: 카운터 · 종료 판정
reward: "보상 계산\n가중합 × 환경 dt"
reset: 완료 환경만 리셋
obs: 관측 계산 · 반환
action -> p1 -> p2 -> term -> reward -> reset -> obs
