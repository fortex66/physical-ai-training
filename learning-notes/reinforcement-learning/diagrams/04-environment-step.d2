direction: down
classes: {
  box: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
action: "행동 처리\nscale 100"
p1: "물리 step 1\n1/120초" {class: focus}
p2: "물리 step 2\n같은 행동 · 1/120초" {class: focus}
term: 카운터 · 종료 판정
reward: "보상 계산\n가중합 × 환경 dt"
reset: 완료 환경만 리셋
obs: 관측 계산 · 반환
action -> p1 -> p2 -> term -> reward -> reset -> obs
