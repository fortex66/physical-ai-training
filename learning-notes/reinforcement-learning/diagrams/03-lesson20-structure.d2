direction: down
classes: {
  box: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
config: "환경 정의\n관측 · 보상 등"
start: 환경 생성 · 리셋
random: "랜덤 행동\ntorch.randn" {class: focus}
step: "env.step\n물리 · 보상 · 리셋"
result: "관측 · 보상\n종료 정보 반환"
log: 로그 기록
stop: "2000 환경 step\n실행 종료"
config -> start -> random -> step -> result -> log -> stop
log -> random: 다음 step {style.stroke-dash: 4}
