digraph G {
graph [bgcolor="#ffffff", pad="0.45", nodesep="0.55", ranksep="0.65", fontname="Noto Sans CJK KR", fontsize=26, fontcolor="#172b45", labelloc=t, splines=polyline];
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=18, fontcolor="#172b45", color="#ccd6e2", fillcolor="#f4f7fb", penwidth=1.4, margin="0.24,0.18"];
edge [color="#8798ac", penwidth=1.6, arrowsize=0.75, fontname="Noto Sans CJK KR", fontsize=13, fontcolor="#52647c"];
label="강화학습 전체 흐름 · 환경 실행과 가중치 학습";
rankdir=TB;
obs [label="01  현재 상태 관측\n위치·각도·속도",fillcolor="#eaf2ff",color="#6293c8"];
actor [label="02  Actor / Policy\n관측을 보고 행동 선택",fillcolor="#f2ecfb",color="#a78ac7"];
critic [label="Critic / 가치망\n앞으로 얻을 보상 추정",fillcolor="#f2ecfb",color="#a78ac7"];
env [label="03  Isaac Lab + Isaac Sim\n행동 적용 → 물리 진행\n다음 관측·보상·종료 반환",fillcolor="#e9f6f0",color="#77ad94"];
buffer [label="04  경험 수집 · Rollout\n관측·행동·보상·가치 추정 등"];
ppo [label="05  PPO 업데이트\n경험으로 Actor·Critic 가중치 수정",fillcolor="#fff4df",color="#d5a65e"];
next [label="06  바뀐 정책으로 다시 경험 수집\n행동 → 수집 → 업데이트 반복",fillcolor="#f2ecfb",color="#a78ac7"];
save [label="체크포인트 저장\n나중에 정책을 로드해 로봇 제어"];
{rank=same;actor;critic} obs -> actor; obs -> critic; actor -> env [label="행동"];
env -> buffer [label="환경 결과"]; critic -> buffer [label="가치 추정"]; actor -> buffer [style=dashed,label="행동 정보"];
buffer -> ppo; ppo -> next; ppo -> save;

}
