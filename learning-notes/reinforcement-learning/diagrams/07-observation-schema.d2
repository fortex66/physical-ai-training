direction: down
classes: {
  box: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
direction: right
state: 관절 상태
pos: 위치 2개
vel: 속도 2개
angle: sin · cos 2개 {class: focus}
norm: "정규화 위치\n1개" {class: focus}
out: "그룹 연결\nN × 7"
state -> pos -> out
state -> vel -> out
state -> angle -> out
state -> norm -> out
