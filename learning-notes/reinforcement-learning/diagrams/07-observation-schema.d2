direction: down
classes: {
  box: {
    width: 240
    height: 110
    style: {font-size: 28; font-color: "#172B45"; fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 10}
  }
  focus: {
    width: 240
    height: 110
    style: {font-size: 28; font-color: "#173C86"; fill: "#EFF5FF"; stroke: "#5D81D9"; stroke-width: 2; border-radius: 10}
  }
}
*.class: box
*.style.font-size: 28
(* -> *)[*].style.stroke: "#64748B"
(* -> *)[*].style.stroke-width: 2
direction: right
state: 관절 상태
pos: 위치 2개
vel: 속도 2개
angle: sin · cos 2개 {class: focus}
norm: "정규화 위치\n1개" {class: focus}
out: "그룹 연결\nN × 7"
state -> pos -> out
state -> vel -> out
state -> angle -> out
state -> norm -> out
