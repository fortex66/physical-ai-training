direction: right
classes: {
  box: {
    width: 170
    height: 78
    style: {font-size: 21; font-color: "#172B45"; fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 10}
  }
  focus: {
    width: 170
    height: 78
    style: {font-size: 21; font-color: "#173C86"; fill: "#EFF5FF"; stroke: "#5D81D9"; stroke-width: 2; border-radius: 10}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#64748B"
(* -> *)[*].style.stroke-width: 2
env: "20 환경 기초\nstep · manager"
obs: "21 관측 · 보상\n정보와 점수"
action: "22 액션 공간\n구동 명령"
complete: "23 환경 조립\n랜덤 기준 측정"
train: "24 PPO 학습\n가중치 저장" {class: focus}
evaluate: "25 정책 평가\n두 정책 비교" {class: focus}
env -> obs -> action -> complete -> train -> evaluate
