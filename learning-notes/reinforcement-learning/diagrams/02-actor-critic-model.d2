direction: down
classes: {
  box: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 190
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
direction: right
obs: "관측\n7개"
a1: "Actor 은닉층\n32 뉴런" {class: focus}
a2: "Actor 은닉층\n32 뉴런" {class: focus}
aout: "행동 분포\n행동 1개 선택" {class: focus}
c1: "Critic 은닉층\n32 뉴런"
c2: "Critic 은닉층\n32 뉴런"
cout: "예상 가치\n숫자 1개"
obs -> a1 -> a2 -> aout
obs -> c1 -> c2 -> cout
