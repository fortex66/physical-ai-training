direction: down
classes: {
  box: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#FFFFFF"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
  focus: {
    width: 250
    height: 78
    style: {font-size: 21; font-color: "#111111"; fill: "#F2F2F2"; stroke: "#333333"; stroke-width: 1; border-radius: 0}
  }
}
*.class: box
*.style.font-size: 21
(* -> *)[*].style.stroke: "#333333"
(* -> *)[*].style.stroke-width: 1
cfg: "여섯 Cfg\n환경 규칙 정의"
init: "환경 100개\n생성 · 리셋"
action: "랜덤 행동\n정규분포 clamp" {class: focus}
step: "env.step\n물리 · 보상 · 리셋"
log: "완료 에피소드\n점수 · 길이 기록"
stop: "500 환경 step\n기준 통계 출력" {class: focus}
cfg -> init -> action -> step -> log -> stop
log -> action: 다음 step {style.stroke-dash: 4}
