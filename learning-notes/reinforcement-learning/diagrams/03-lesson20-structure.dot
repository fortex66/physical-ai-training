digraph G {
graph [bgcolor="#ffffff", pad="0.45", nodesep="0.55", ranksep="0.65", fontname="Noto Sans CJK KR", fontsize=26, fontcolor="#172b45", labelloc=t, splines=polyline];
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=18, fontcolor="#172b45", color="#ccd6e2", fillcolor="#f4f7fb", penwidth=1.4, margin="0.24,0.18"];
edge [color="#8798ac", penwidth=1.6, arrowsize=0.75, fontname="Noto Sans CJK KR", fontsize=13, fontcolor="#52647c"];
label="20장 실행 구조 · 랜덤 행동으로 환경 테스트";
rankdir=TB;
cfg [label="환경 정의\nScene · Action · Observation\nReward · Termination · Event"];
init [label="01  main()\n환경 생성 → env.reset()"];
random [label="02  torch.randn(N, 1)\n관측과 무관한 랜덤 행동",fillcolor="#fff4df"];
step [label="03  env.step(action)\n물리·보상·종료·자동 리셋",fillcolor="#e9f6f0"];
result [label="04  반환 결과\nobs · rew · terminated · truncated · info"];
log [label="05  보상 누적·에피소드 로그\n2000 환경 step까지 실행"];
endrun [label="실행 종료\n신경망 생성·PPO 업데이트 없음",fillcolor="#fff4df"];
cfg -> init -> random -> step -> result -> log -> endrun;
log -> random [style=dashed,label="상한 전: 다음 step",constraint=false];

}
